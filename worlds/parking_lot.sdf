<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="parking_world">
    <gravity>0 0 -9.81</gravity>
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.4 0.1 -0.9</direction></light>

    <model name="ground"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry></collision><visual name="asphalt"><geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry><material><ambient>0.12 0.14 0.16 1</ambient><diffuse>0.18 0.20 0.22 1</diffuse></material></visual></link></model>
    <model name="road_marking"><static>true</static><link name="link"><visual name="line"><pose>0 0 0.012 0 0 0</pose><geometry><box><size>18 0.12 0.02</size></box></geometry><material><emissive>0.9 0.75 0.1 1</emissive></material></visual></link></model>
    <model name="parking_sign"><static>true</static><pose>1.1 -2.2 0 0 0 0</pose><link name="link"><visual name="post"><pose>0 0 1 0 0 0</pose><geometry><box><size>0.08 0.08 2</size></box></geometry><material><diffuse>0.2 0.2 0.2 1</diffuse></material></visual><visual name="sign"><pose>0 0 1.8 0 0 0</pose><geometry><box><size>0.1 0.8 0.5</size></box></geometry><material><emissive>0.1 0.35 0.9 1</emissive></material></visual></link></model>

    <model name="barrier" canonical_link="base">
      <pose>0 -1.65 0 0 0 0</pose>
      <link name="base"><gravity>false</gravity><visual name="housing"><pose>0 0 0.65 0 0 0</pose><geometry><box><size>0.45 0.55 1.3</size></box></geometry><material><diffuse>0.95 0.55 0.05 1</diffuse></material></visual><visual name="pivot_collar"><pose>0 0 1.25 0 0 0</pose><geometry><cylinder><radius>0.24</radius><length>0.14</length></cylinder></geometry><material><diffuse>0.18 0.18 0.18 1</diffuse></material></visual><collision name="housing_collision"><pose>0 0 0.65 0 0 0</pose><geometry><box><size>0.45 0.55 1.3</size></box></geometry></collision></link>
      <!-- One named frame is the sole source of truth for the physical hinge. -->
      <frame name="hinge" attached_to="base"><pose relative_to="base">0 0 1.25 0 0 0</pose></frame>
      <!-- The visual boom extends back through the collar into the housing.
           This deliberate overlap removes the apparent perspective gap at the
           hinge; the unchanged collision beam preserves the tuned dynamics. -->
      <!-- The tip cap overlaps the far end,
           eliminating the visible seams at both ends while retaining one solid
           collision volume for the closed gate. -->
      <link name="arm"><pose relative_to="hinge">0 0 0 0 0 0</pose><inertial><pose>0 1.60 0 0 0 0</pose><mass>4</mass><inertia><ixx>3.975</ixx><iyy>0.014</iyy><izz>3.974</izz></inertia></inertial><visual name="boom"><pose>0 1.40 0 0 0 0</pose><geometry><box><size>0.14 4.00 0.15</size></box></geometry><material><diffuse>0.95 0.95 0.95 1</diffuse></material></visual><visual name="red_tip"><pose>0 3.35 0 0 0 0</pose><geometry><box><size>0.18 0.30 0.19</size></box></geometry><material><emissive>0.9 0.05 0.05 1</emissive></material></visual><collision name="arm_collision"><pose>0 1.60 0 0 0 0</pose><geometry><box><size>0.14 3.45 0.15</size></box></geometry></collision></link>
      <joint name="base_to_world" type="fixed"><parent>world</parent><child>base</child></joint>
      <joint name="barrier_joint" type="revolute"><parent>base</parent><child>arm</child><pose relative_to="hinge">0 0 0 0 0 0</pose><axis><xyz>1 0 0</xyz><limit><lower>0</lower><upper>1.57</upper><effort>250</effort><velocity>2</velocity></limit><dynamics><damping>12.0</damping></dynamics></axis></joint>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>barrier_joint</joint_name><topic>/parking/barrier_command</topic><p_gain>100</p_gain><i_gain>0.0</i_gain><d_gain>12.0</d_gain></plugin>
    </model>

    <model name="vehicle">
      <!-- The model frame is on the road, so the 0.30 m radius wheels start in
           contact with it.  Raising the model here leaves both wheels airborne. -->
      <!-- Start in the visible approach lane; +X remains the route to the gate. -->
      <pose>-3.0 0 0 0 0 0</pose>
      <link name="chassis"><gravity>false</gravity><inertial><mass>40</mass><inertia><ixx>12</ixx><iyy>20</iyy><izz>20</izz></inertia></inertial><collision name="collision"><pose>0 0 0.4 0 0 0</pose><geometry><box><size>1.6 1.1 0.55</size></box></geometry></collision><visual name="body"><pose>0 0 0.4 0 0 0</pose><geometry><box><size>1.6 1.1 0.55</size></box></geometry><material><diffuse>0.05 0.3 0.85 1</diffuse></material></visual><visual name="roof"><pose>0 0 0.78 0 0 0</pose><geometry><box><size>0.75 0.9 0.28</size></box></geometry><material><diffuse>0.2 0.5 0.95 1</diffuse></material></visual></link>
      <link name="left_wheel"><gravity>false</gravity><pose>0 0.62 0.3 1.5708 0 0</pose><inertial><mass>2</mass><inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.05</izz></inertia></inertial><visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.18</length></cylinder></geometry><material><diffuse>0.03 0.03 0.03 1</diffuse></material></visual></link>
      <link name="right_wheel"><gravity>false</gravity><pose>0 -0.62 0.3 1.5708 0 0</pose><inertial><mass>2</mass><inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.05</izz></inertia></inertial><visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.18</length></cylinder></geometry><material><diffuse>0.03 0.03 0.03 1</diffuse></material></visual></link>
      <joint name="left_wheel_joint" type="fixed"><parent>chassis</parent><child>left_wheel</child></joint><joint name="right_wheel_joint" type="fixed"><parent>chassis</parent><child>right_wheel</child></joint>
      <!-- The car is a deterministic lidar target, not a drivetrain demo. -->
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"><topic>/model/vehicle/cmd_vel</topic></plugin>
    </model>

    <!-- Faces arriving vehicles (-X), so fixed barrier geometry behind it is excluded. -->
    <model name="approach_sensor"><static>true</static><pose>-1.5 0 0.45 0 0 3.14159</pose><link name="link"><inertial><mass>0.1</mass><inertia><ixx>0.00017</ixx><iyy>0.00017</iyy><izz>0.00017</izz></inertia></inertial><sensor name="approach_lidar" type="gpu_lidar"><topic>/parking/approach_scan</topic><update_rate>20</update_rate><lidar><scan><horizontal><samples>61</samples><resolution>1</resolution><min_angle>-0.52</min_angle><max_angle>0.52</max_angle></horizontal><vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan><range><min>0.08</min><max>4.0</max><resolution>0.02</resolution></range></lidar><always_on>1</always_on><visualize>true</visualize></sensor><visual name="post"><pose>0 0 -0.5 0 0 0</pose><geometry><cylinder><radius>0.05</radius><length>1</length></cylinder></geometry><material><emissive>0.1 0.9 0.2 1</emissive></material></visual></link></model>
    <!-- Faces downstream (+X).  A vehicle must enter and then clear this gate before closing. -->
    <model name="passage_sensor"><static>true</static><pose>1.3 0 0.45 0 0 0</pose><link name="link"><inertial><mass>0.1</mass><inertia><ixx>0.00017</ixx><iyy>0.00017</iyy><izz>0.00017</izz></inertia></inertial><sensor name="passage_lidar" type="gpu_lidar"><topic>/parking/passage_scan</topic><update_rate>20</update_rate><lidar><scan><horizontal><samples>61</samples><resolution>1</resolution><min_angle>-0.52</min_angle><max_angle>0.52</max_angle></horizontal><vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan><range><min>0.08</min><max>4.0</max><resolution>0.02</resolution></range></lidar><always_on>1</always_on><visualize>true</visualize></sensor><visual name="post"><pose>0 0 -0.5 0 0 0</pose><geometry><cylinder><radius>0.05</radius><length>1</length></cylinder></geometry><material><emissive>0.9 0.1 0.2 1</emissive></material></visual></link></model>
  </world>
</sdf>
