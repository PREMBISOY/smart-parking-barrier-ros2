<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="parking_barrier_reference">
  <!-- Reference geometry; the executable Gazebo model is in parking_lot.sdf. -->
  <link name="base"/>
  <link name="arm"/>
  <joint name="barrier_joint" type="revolute"><parent link="base"/><child link="arm"/><axis xyz="1 0 0"/><limit lower="0" upper="1.57" effort="100" velocity="2"/></joint>
</robot>
